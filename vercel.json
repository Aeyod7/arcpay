{
  "version": 2,
  "builds": [
    {
      "src": "apps/api/server.mjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "prisma/**",
          "../../packages/sdk/dist/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/api/server.mjs"
    }
  ]
}
