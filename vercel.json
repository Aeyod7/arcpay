{
  "version": 2,
  "builds": [
    {
      "src": "apps/api/server.mjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "apps/api/prisma/**",
          "packages/sdk/dist/**",
          "node_modules/.prisma/client/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/api/server.mjs"
    }
  ]
}
